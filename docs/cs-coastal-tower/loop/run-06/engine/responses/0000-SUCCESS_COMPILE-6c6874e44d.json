{
 "residues": [
  {
   "id": "level-builds",
   "description": "The mod's level list includes 06 and its editor objects build without an exception into a level of walls, water and markers.",
   "required": true,
   "priority": 95,
   "contract": {
    "kind": "check",
    "probe": {
     "tool": "pb3x.check",
     "params": {
      "script": "tools/harness/levels/lint.js",
      "args": [
       "06"
      ]
     }
    },
    "asserts": [
     {
      "path": "json.level",
      "op": "eq",
      "value": "06"
     },
     {
      "path": "json.error",
      "op": "falsy"
     },
     {
      "path": "json.counts.walls",
      "op": "gte",
      "value": 40
     },
     {
      "path": "json.counts.water",
      "op": "gte",
      "value": 1
     }
    ]
   },
   "rationale": "Everything else stands on the level existing as editor objects."
  },
  {
   "id": "plays-clean",
   "description": "Play as tester runs 06 with no map errors, no uncaught page errors and no error recorded by the mod.",
   "required": true,
   "priority": 90,
   "contract": {
    "kind": "check",
    "probe": {
     "tool": "pb3x.harness",
     "params": {
      "script": "levels/play-06.js",
      "report": "levels/results/06-report.json",
      "timeoutMs": 1800000
     }
    },
    "asserts": [
     {
      "path": "report.tests.frames.ok",
      "op": "truthy"
     },
     {
      "path": "report.tests.frames.mapErrors",
      "op": "eq",
      "value": 0
     },
     {
      "path": "report.tests.frames.pageErrors",
      "op": "eq",
      "value": 0
     },
     {
      "path": "report.failed",
      "op": "falsy"
     }
    ]
   },
   "rationale": "Hard constraint: the page never crashes; the level adds no page errors.",
   "dependsOn": [
    "level-builds"
   ]
  },
  {
   "id": "design-rules",
   "description": "No geometry in 06 breaks the design rules: every walkway ceiling is at least 100 px, stairs keep risers of 30 px or less, berths have 240 px clear, no underwater dead end sits under a wall, and every character stands on a floor clear of walls.",
   "required": true,
   "priority": 88,
   "contract": {
    "kind": "check",
    "probe": {
     "tool": "pb3x.check",
     "params": {
      "script": "tools/harness/levels/lint.js",
      "args": [
       "06"
      ]
     }
    },
    "asserts": [
     {
      "path": "json.violationCount",
      "op": "eq",
      "value": 0
     }
    ]
   },
   "rationale": "metrics.md section 2, checked on every wall.",
   "dependsOn": [
    "level-builds"
   ]
  },
  {
   "id": "route-complete",
   "description": "From the raiders' start every objective, the exit, every foot checkpoint and every vehicle is reachable with the measured moves, and every enemy is reachable or can be engaged within 1000 px.",
   "required": true,
   "priority": 86,
   "contract": {
    "kind": "check",
    "probe": {
     "tool": "pb3x.check",
